{
  "manifest_version": 2,
  "name": "Tab Hoardr",
  "version": "0.1.0",
  "description": "Hoard tabs, export them as JSON for Obsidian.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-hoardr@kbbk",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "downloads",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib.js",
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon.svg",
    "default_title": "Tab Hoardr"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "save-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Save the current tab"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
