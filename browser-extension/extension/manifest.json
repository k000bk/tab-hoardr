{
  "manifest_version": 3,
  "name": "Tab Hoardr",
  "version": "1.0.0",
  "description": "Hoard tabs, export them as JSON for Obsidian.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-hoardr@kbbk",
      "strict_min_version": "127.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "scripts": [
      "compat.js",
      "lib.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_title": "Tab Hoardr"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "compat.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "save-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Save the current tab"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
